{
  "$extensions": {
    "dev.ruviform.dtcg-profile": {
      "profile": "rvf-dtcg-profile.v1",
      "layer": "product",
      "id": "synvelis-dark",
      "modes": ["dark"]
    },
    "synvelis.productTheme": {
      "schema": 1,
      "theme": "synvelis",
      "mode": "dark",
      "layer": "product"
    },
    "synvelis.provenance": "ui/src/styles.css (pre-native dark palette, observed values); color.status-* provisional ramp (AUTX-07, pending native design review); canonical surface/text/accent/state/control/viz groups alias color.* (state.disabled + viz.waveform_rms provisional direct values, pending native design review)"
  },
  "color": {
    "$type": "color",
    "bg":          { "$value": "#1b1d21" },
    "bg-panel":    { "$value": "#23262c" },
    "fg":          { "$value": "#e8e8ea" },
    "fg-dim":      { "$value": "#9aa0a8" },
    "accent":      { "$value": "#6aa9e8" },
    "warn":        { "$value": "#f0a868" },
    "err":         { "$value": "#e86a6a" },
    "ok":          { "$value": "#6ac88a" },
    "bg-hover":    { "$value": "#2c3038" },
    "bg-active":   { "$value": "#3a3f47" },
    "bg-input":    { "$value": "#191b1f" },
    "border":      { "$value": "#33373f" },
    "status-ok":                     { "$value": "#6ac88a" },
    "status-unavailable":            { "$value": "#767e88" },
    "status-unknown":                { "$value": "#9aa0a8" },
    "status-pending":                { "$value": "#8fb8e8" },
    "status-running":                { "$value": "#6aa9e8" },
    "status-completed":              { "$value": "#4ec9a4" },
    "status-failed":                 { "$value": "#e86a6a" },
    "status-cancel-requested":       { "$value": "#f0a868" },
    "status-cancel-unconfirmed":     { "$value": "#e0aa4e" },
    "status-cancelled":              { "$value": "#c9725f" },
    "status-indeterminate":          { "$value": "#d9b44a" },
    "status-unsupported":            { "$value": "#b48ae0" },
    "status-stale":                  { "$value": "#8f987c" },
    "status-dirty":                  { "$value": "#a08f68" },
    "status-diagnostic-information": { "$value": "#7aa8d8" },
    "status-diagnostic-warning":     { "$value": "#f0a868" },
    "status-diagnostic-error":       { "$value": "#e86a6a" }
  },
  "surface": {
    "$type": "color",
    "bg":      { "$value": "{color.bg}" },
    "raised":  { "$value": "{color.bg-panel}" },
    "border":  { "$value": "{color.border}" }
  },
  "text": {
    "$type": "color",
    "primary": { "$value": "{color.fg}" },
    "dim":     { "$value": "{color.fg-dim}" }
  },
  "accent": {
    "$type": "color",
    "primary": { "$value": "{color.accent}" }
  },
  "state": {
    "$type": "color",
    "error":    { "$value": "{color.err}" },
    "disabled": { "$value": "#4e565f" }
  },
  "control": {
    "$type": "color",
    "track": { "$value": "{color.bg-input}" },
    "fill":  { "$value": "{color.accent}" },
    "thumb": { "$value": "{color.fg}" }
  },
  "viz": {
    "$type": "color",
    "waveform":      { "$value": "{color.accent}" },
    "waveform_rms":  { "$value": "#8fb8e8" },
    "baseline":      { "$value": "{color.border}" },
    "cursor":        { "$value": "{color.fg}" }
  }
}
