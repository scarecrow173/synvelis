{
  "$extensions": {
    "dev.ruviform.dtcg-profile": {
      "profile": "rvf-dtcg-profile.v1",
      "layer": "product",
      "id": "synvelis-base"
    },
    "synvelis.productTheme": {
      "schema": 1,
      "theme": "synvelis",
      "layer": "product"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "ui":   { "$value": ["system-ui", "Segoe UI", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium":  { "$value": 500 },
      "bold":    { "$value": 700 }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 2, "unit": "px" } },
    "md": { "$value": { "value": 4, "unit": "px" } },
    "lg": { "$value": { "value": 8, "unit": "px" } }
  },
  "motion": {
    "$type": "duration",
    "fast":   { "$value": { "value": 100, "unit": "ms" } },
    "normal": { "$value": { "value": 200, "unit": "ms" } }
  },
  "easing": {
    "standard": {
      "$type": "cubicBezier",
      "$value": [0.2, 0.0, 0.0, 1.0]
    }
  }
}
