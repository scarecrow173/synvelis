{
  "$extensions": {
    "dev.ruviform.dtcg-profile": {
      "profile": "rvf-dtcg-profile.v1",
      "layer": "product",
      "id": "synvelis-light",
      "modes": ["light"]
    },
    "synvelis.productTheme": {
      "schema": 1,
      "theme": "synvelis",
      "mode": "light",
      "layer": "product"
    },
    "synvelis.provenance": "provisional-pending-native-design-review (incl. color.status-* ramp, color.bg-input/bg-active, state.disabled + viz.waveform_rms canonical direct values)"
  },
  "color": {
    "$type": "color",
    "bg":          { "$value": "#f5f6f8" },
    "bg-panel":    { "$value": "#e8eaee" },
    "fg":          { "$value": "#1b1d21" },
    "fg-dim":      { "$value": "#5a6068" },
    "accent":      { "$value": "#2a6bc2" },
    "warn":        { "$value": "#b06a20" },
    "err":         { "$value": "#c23a3a" },
    "ok":          { "$value": "#2a8a4a" },
    "bg-hover":    { "$value": "{color.bg-panel}" },
    "bg-active":   { "$value": "#e0e4e9" },
    "bg-input":    { "$value": "#eaecf0" },
    "border":      { "$value": "{color.bg-panel}" },
    "status-ok":                     { "$value": "#2a8a4a" },
    "status-unavailable":            { "$value": "#6e7680" },
    "status-unknown":                { "$value": "#5a6068" },
    "status-pending":                { "$value": "#5b84b8" },
    "status-running":                { "$value": "#2a6bc2" },
    "status-completed":              { "$value": "#1f7a5c" },
    "status-failed":                 { "$value": "#c23a3a" },
    "status-cancel-requested":       { "$value": "#b06a20" },
    "status-cancel-unconfirmed":     { "$value": "#9a6f1e" },
    "status-cancelled":              { "$value": "#a8543c" },
    "status-indeterminate":          { "$value": "#8a6d1f" },
    "status-unsupported":            { "$value": "#7a4fa8" },
    "status-stale":                  { "$value": "#6e7346" },
    "status-dirty":                  { "$value": "#7a6a48" },
    "status-diagnostic-information": { "$value": "#3d6ea8" },
    "status-diagnostic-warning":     { "$value": "#b06a20" },
    "status-diagnostic-error":       { "$value": "#c23a3a" }
  },
  "surface": {
    "$type": "color",
    "bg":      { "$value": "{color.bg}" },
    "raised":  { "$value": "{color.bg-panel}" },
    "border":  { "$value": "{color.border}" }
  },
  "text": {
    "$type": "color",
    "primary": { "$value": "{color.fg}" },
    "dim":     { "$value": "{color.fg-dim}" }
  },
  "accent": {
    "$type": "color",
    "primary": { "$value": "{color.accent}" }
  },
  "state": {
    "$type": "color",
    "error":    { "$value": "{color.err}" },
    "disabled": { "$value": "#9aa0a8" }
  },
  "control": {
    "$type": "color",
    "track": { "$value": "{color.bg-input}" },
    "fill":  { "$value": "{color.accent}" },
    "thumb": { "$value": "{color.fg}" }
  },
  "viz": {
    "$type": "color",
    "waveform":      { "$value": "{color.accent}" },
    "waveform_rms":  { "$value": "#7aa8d8" },
    "baseline":      { "$value": "{color.border}" },
    "cursor":        { "$value": "{color.fg}" }
  }
}
