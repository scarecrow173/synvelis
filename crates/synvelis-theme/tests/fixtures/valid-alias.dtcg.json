{
  "$extensions": {
    "synvelis.productTheme": {
      "schema": 1,
      "theme": "test",
      "mode": "dark",
      "layer": "product"
    }
  },
  "color": {
    "$type": "color",
    "bg":     { "$value": "#000000" },
    "fg":     { "$value": "#ffffff" },
    "fg-dim": { "$value": "{color.fg}" }
  },
  "spacing": {
    "md": { "$type": "dimension", "$value": "8px" }
  }
}
