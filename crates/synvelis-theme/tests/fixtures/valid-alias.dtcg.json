{
  "$extensions": {
    "dev.ruviform.dtcg-profile": {
      "profile": "rvf-dtcg-profile.v1",
      "layer": "product",
      "id": "test-alias",
      "modes": ["dark"]
    },
    "synvelis.productTheme": {
      "schema": 1,
      "theme": "test",
      "mode": "dark",
      "layer": "product"
    }
  },
  "color": {
    "$type": "color",
    "bg":     { "$value": "#000000" },
    "fg":     { "$value": "#ffffff" },
    "fg-dim": { "$value": "{color.fg}" }
  },
  "spacing": {
    "md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
  }
}
