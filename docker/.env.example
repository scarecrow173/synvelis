# docker-compose.webdav.yml が読む変数のテンプレ。
# 実値は `cp docker/.env.example docker/.env` してから編集する。
# docker/.env は gitignore 済みでありコミットしない。

# ホスト側に公開する HTTPS ポート（https://localhost:<WEBDAV_PORT>）
WEBDAV_PORT=8443

# Basic 認証。ローカル検証専用の任意値。実在のパスワードを流用しない。
WEBDAV_USER=synvelis
WEBDAV_PASSWORD=change-me-local-only
